{
  "name": "fantasybasketballxyz",
  "private": true,
  "workspaces": [
    "functions",
    "app"
  ],
  "scripts": {
    "tests": "jest --silent --coverage --coverageReporters=text-summary",
    "typecheck": "tsc -p . && cd app && next typegen > /dev/null && tsc -p .",
    "lint": "eslint . --quiet",
    "format": "prettier --write . --log-level warn",
    "dev:app": "node -e \"require.resolve('next')\" 2>/dev/null || npm install --silent --no-audit --no-fund && npm run -s dev -w app",
    "build:app": "node -e \"require.resolve('next')\" 2>/dev/null || npm install --silent --no-audit --no-fund && npm run -s build -w app",
    "e2e:app": "playwright test -c app/playwright.config.ts --trace off --reporter=line"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "undici": "^6.29.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
