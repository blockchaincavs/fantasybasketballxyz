# Copy to .env and fill in. Never commit .env.
BALLDONTLIE_API_KEY=
# Appwrite Cloud: the ONE project (fbx-dev) holds Dev and Prod as databases fbx_dev / fbx_prod.
# Scripts and tests refuse any other project id and only use fbx_dev. Never create another project.
APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=fbx-dev
APPWRITE_API_KEY=
# Must be "dev" for setup, demos and integration tests (they refuse to run otherwise).
APPWRITE_ENV=dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Front end (app/): optional. With none set, the app uses fbx-dev and the Dev database fbx_dev.
# Overrides go in app/.env.local. Public, non-secret values only; never a key.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=fbx-dev
NEXT_PUBLIC_APPWRITE_DATABASE_ID=fbx_dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000
