{
  "permissions": {
    "allow": [
      "Bash(npm run tests)",
      "Bash(npm run -s tests)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": ["Read(./.env)"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-tests.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*appwrite.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-paid-resources.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
